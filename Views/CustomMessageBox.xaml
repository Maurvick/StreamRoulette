<Window x:Class="StreamRoulette.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="200" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

	<Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource ThemeMainBrush}"
            BorderThickness="2"
            CornerRadius="0">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="35"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="60"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Background="{StaticResource ControlBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
				<TextBlock x:Name="TxtTitle" 
                           Text="TITLE" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="15,0,0,0"/>

				<Button Content="✕" 
                        HorizontalAlignment="Right"
                        Width="40" Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnClose_Click">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border Background="{TemplateBinding Background}">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="#E81123"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</Grid>

			<TextBlock x:Name="TxtMessage" 
                       Grid.Row="1"
                       Text="Message text goes here..." 
                       Foreground="White"
                       FontSize="16"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20"/>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">

				<Button x:Name="BtnYes" 
                        Content="Yes" 
                        Width="100" Height="35" 
                        Margin="10,0"
                        Click="BtnYes_Click"/>

				<Button x:Name="BtnNo" 
                        Content="No" 
                        Width="100" Height="35" 
                        Margin="10,0"
                        Background="{StaticResource ControlBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Click="BtnClose_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>